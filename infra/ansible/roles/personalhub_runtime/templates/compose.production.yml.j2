---
name: personalhub

services:
  postgres:
    image: "{{ personalhub_postgres_image }}"
    platform: linux/arm64
    environment:
      POSTGRES_DB: "{{ personalhub_database_name }}"
      POSTGRES_USER: "{{ personalhub_database_user }}"
      POSTGRES_PASSWORD: ${PERSONALHUB_POSTGRES_PASSWORD:?runtime environment not materialized}
      TZ: Etc/UTC
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - backend
    restart: unless-stopped
    healthcheck:
      test:
        - CMD-SHELL
        - "pg_isready -U {{ personalhub_database_user }} -d {{ personalhub_database_name }}"
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 10s
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: 10m
        max-file: "3"

  app:
    image: ${PERSONALHUB_IMAGE:?release environment not configured}
    platform: linux/arm64
    environment:
      NODE_ENV: production
      NEXT_TELEMETRY_DISABLED: "1"
      PERSONALHUB_DATABASE_URL: ${PERSONALHUB_DATABASE_URL:?runtime environment not materialized}
      PERSONALHUB_TRUST_PROXY: "true"
      PERSONALHUB_TIME_ZONE: "{{ personalhub_time_zone }}"
      TZ: Etc/UTC
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - backend
    restart: unless-stopped
    init: true
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "fetch('http://localhost:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 20s
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: 10m
        max-file: "3"

volumes:
  postgres_data:
    name: personalhub-production-postgres-data

networks:
  backend:
    name: personalhub-production-backend
    internal: true
