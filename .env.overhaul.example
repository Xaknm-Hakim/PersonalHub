# Create the real ignored file safely instead:
#   ./scripts/setup-overhaul-env.sh
#
# If setting it manually, use one URL-safe local password in both places.
PERSONALHUB_POSTGRES_PASSWORD=replace-with-a-random-local-password
PERSONALHUB_DATABASE_URL=postgresql://personalhub:replace-with-a-random-local-password@127.0.0.1:5433/personalhub?schema=public
PERSONALHUB_PUBLIC_ORIGIN=https://personalhub.example
PERSONALHUB_GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id
PERSONALHUB_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
PERSONALHUB_INTEGRATION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
