# Server-only secret: use a unique database password and never commit the real URL.
PERSONALHUB_DATABASE_URL="postgresql://personalhub:replace-me@127.0.0.1:5433/personalhub?schema=public"
PERSONALHUB_POSTGRES_PASSWORD="replace-me"

# Server-only behavior. Enable only behind a proxy that overwrites forwarded headers.
PERSONALHUB_TRUST_PROXY="false"

# Bootstrap-only secret; supply temporarily to `npm run owner:bootstrap`, then unset it.
# PERSONALHUB_OWNER_PASSWORD=""

# Safe server configuration (not exposed to browser bundles).
PERSONALHUB_TIME_ZONE="Asia/Kuala_Lumpur"
